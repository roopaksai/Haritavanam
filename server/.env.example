# Haritavanam API — environment
# Copy to .env and adjust. Every value has a working default for local development.

PORT=4000
NODE_ENV=development
APP_ORIGIN=http://localhost:5173

# Leave empty to use the local JSON store (server/data/db.json).
# Set to a MongoDB cluster URI to switch storage. The schema is identical.
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_URI=
MONGODB_DB=haritavanam

# Disease detection is mocked until a key is supplied.
# When set, the analyse endpoint is ready to proxy to the provider.
PLANT_ID_API_KEY=
