# Haritavanam frontend environment variables

# When unset, the app runs in local-first (standalone) mode:
# all data lives in IndexedDB in the browser and no backend is required.
# Demo accounts: admin@haritavanam.test / owner@haritavanam.test /
# monitor@haritavanam.test / meera@haritavanam.test
# Password for all: Haritavanam@123

# Set this to your remote backend (e.g. the MongoDB-backed Express API)
# to store data in the cloud instead of locally.
# VITE_API_URL=https://your-haritavanam-api.example.com

# Legacy Supabase vars (no longer used; kept for reference)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
